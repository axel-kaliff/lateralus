#!/bin/bash
# lateralus override — upstream marks the decoded value sensitive so clipboard
# history won't retain it, but that flag is upstream-git-only and Fedora 44
# ships wl-clipboard 2.2.1. wl-copy exited 1 without ever setting the clipboard, so
# the copy silently failed while the notification still claimed success.
#
# Dropping the flag is the only fix available on this wl-clipboard: the hint
# rides on an extra x-kde-passwordManagerHint offer that 2.2.1 cannot make.
# The trade-off is that a decoded secret (an otpauth:// 2FA seed, say) is now
# retained by clipboard history (~/.local/state/omarchy/clipboard-history.json);
# the clipboard manager on SUPER + CTRL + V can clear it.

# omarchy:summary=Decode a QR code from a screenshot region
# omarchy:group=capture
# omarchy:examples=omarchy capture qr

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

# Decode QR codes only. Leaving the other symbologies enabled lets dense screen
# content false-positive as an EAN or Code 39 barcode and take over the clipboard.
RESULT=$(grim -g "$SELECTION" - | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null)

if [[ -z $RESULT ]]; then
  omarchy-notification-send -g 󰐲 -u critical "No QR code found" "Select a region containing a QR code"
  exit 1
fi

# Still kept out of the journal and the notification body -- only the clipboard
# history retention that --sensitive would have prevented is given up here.
printf '%s' "$RESULT" | wl-copy
omarchy-notification-send -g 󰐲 "QR code copied to clipboard"
