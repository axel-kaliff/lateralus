[Unit]
Description=Stage bootc image upgrade for next boot
Wants=network-online.target
After=network-online.target
Documentation=man:bootc-upgrade(8)

[Service]
Type=oneshot
ExecStart=/usr/bin/bootc upgrade
# Refresh the staged-update flag the Omarchy bar's update badge reads
ExecStartPost=/usr/libexec/lateralus-update-flag
StandardOutput=journal
StandardError=journal
